{
  "name": "eburum-team-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm --prefix tests test && node --test tests/frontend-interactions.cjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run build && npm test && node --test tests/frontend-build.cjs",
    "format:check": "prettier --check src app-roles.ts app-data.ts eslint.config.js vite.config.ts tsconfig.json components.json",
    "lint": "eslint src app-roles.ts app-data.ts --max-warnings 0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tooltip": "1.3.0",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-virtual": "3.14.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
